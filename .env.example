# Base de données (docker compose expose postgres sur 127.0.0.1:5432)
POSTGRES_PASSWORD=wristmasters
DATABASE_URL=postgresql://wristmasters:wristmasters@localhost:5432/wristmasters

# Jeton de la page /admin (en-tête Authorization: Bearer …). Mettre une longue valeur aléatoire en production.
ADMIN_TOKEN=dev-admin-token

# Port de l'API NestJS
PORT=3000

# Production (docker compose) : domaine servi par Caddy, secret d'Umami
DOMAIN=localhost
STATS_DOMAIN=stats.localhost
UMAMI_APP_SECRET=change-me

# Ingestion : contact inscrit dans le User-Agent envoyé à Wikidata / Wikipédia (URL ou e-mail du projet)
INGEST_CONTACT=https://github.com/organisation/wristmasters-tcg
