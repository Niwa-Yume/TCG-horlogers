# Base de données (docker compose expose postgres sur 127.0.0.1:5432)
POSTGRES_PASSWORD=wristmasters
DATABASE_URL=postgresql://wristmasters:wristmasters@localhost:5432/wristmasters

# Jeton de la page /admin (en-tête Authorization: Bearer …). Mettre une longue valeur aléatoire en production.
ADMIN_TOKEN=dev-admin-token

# Port de l'API NestJS
PORT=3000

# Sessions : secret de signature des cookies JWT (32 caractères au moins ; `openssl rand -hex 32` en production)
SESSION_SECRET=dev-session-secret-change-me-0123456789abcdef
# URL publique du site (redirections OAuth, liens et images de partage)
PUBLIC_URL=http://localhost:5173

# Connexion (optionnelle : sans identifiants, les boutons n'apparaissent pas)
# Google : console.cloud.google.com → Identifiants → ID client OAuth, redirection <PUBLIC_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Discord : discord.com/developers → OAuth2, redirection <PUBLIC_URL>/api/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Umami (mesure) : identifiant du site créé dans l'interface Umami, et URL de son script
VITE_UMAMI_WEBSITE_ID=
VITE_UMAMI_SRC=

# Production (docker compose) : domaine servi par Caddy, secret d'Umami
DOMAIN=localhost
STATS_DOMAIN=stats.localhost
UMAMI_APP_SECRET=change-me

# Ingestion : contact inscrit dans le User-Agent envoyé à Wikidata / Wikipédia (URL ou e-mail du projet)
INGEST_CONTACT=https://github.com/organisation/wristmasters-tcg
