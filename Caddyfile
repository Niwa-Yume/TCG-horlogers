{$DOMAIN:localhost} {
	encode zstd gzip

	handle /api/* {
		reverse_proxy api:3000
	}

	# pages de partage avec balises Open Graph, rendues par l'API
	handle /partage/* {
		rewrite * /api{uri}
		reverse_proxy api:3000
	}

	handle {
		root * /srv
		# fichiers Vite (nom haché) : cache permanent ; cadrans et sons : une semaine (même nom si regénérés)
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		header /dials/* Cache-Control "public, max-age=604800"
		header /sounds/* Cache-Control "public, max-age=604800"
		try_files {path} /index.html
		file_server
	}
}

{$STATS_DOMAIN:stats.localhost} {
	reverse_proxy umami:3000
}
